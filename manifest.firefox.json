{
  "manifest_version": 3,
  "name": "MakerWorld to Snapmaker U1",
  "version": "1.5.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "makerworld-to-snapmaker-u1@dragon2203",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "Convert MakerWorld print profiles into Snapmaker U1 project files directly in your browser.",
  "icons": {
  "16": "assets/icons/icon16.png",
  "32": "assets/icons/icon32.png",
  "48": "assets/icons/icon48.png",
  "128": "assets/icons/icon128.png"
},
"action": {
  "default_icon": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png"
  }
},
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://makerworld.com.cn/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://makerworld.com.cn/*"
      ],
      "js": [
        "lib/jszip.min.js",

        "u1_custom_printer_profiles.js",
        "u1_filament_merge.js",
        "u1_project_merge.js",
        "u1_profile_resolver.js",
        "u1_compatibility.js",
        "u1_model_parser.js",
        "u1_bambu_parser.js",
        "u1_project_parser.js",
        "u1_project_builder.js",
        "u1_3mf_metadata.js",
        "u1_project_report.js",
        "converter.js",
        "u1_error_report.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/profiles/*", "injected.js"],
      "matches": [
        "https://makerworld.com/*",
        "https://makerworld.com.cn/*"
      ]
    }
  ]
}
